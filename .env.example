# Variables de entorno para el endpoint /api/leads (ver README).
# Los valores reales se configuran en Vercel → Settings → Environment Variables
# y NUNCA se suben al repositorio.

# API key de resend.com
RESEND_API_KEY=re_xxxxxxxxxxxx

# Email que recibe los leads
LEADS_TO_EMAIL=clientes@plancrece.com

# Remitente verificado en Resend (si falta, usa onboarding@resend.dev)
LEADS_FROM_EMAIL=web@plancrece.com
